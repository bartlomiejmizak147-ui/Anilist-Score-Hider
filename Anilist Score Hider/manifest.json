{
    "manifest_version": 3,
    "name": "Anilist Score Hider",
    "version": "1.0",
    "description": "Extension that hides all mean and average score's from anilist so you don't go in with a biased opinion",
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "anilist-score-hider@buhtek"
        }
    },
    "content_scripts": [
        { "matches": ["https://anilist.co/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }
    ]
}